BINANCE_API_KEY=replace_me
BINANCE_API_SECRET=replace_me
# 1 for Binance testnet, 0 for production
BINANCE_USE_TESTNET=1
# 1 enables real order submission in the polling worker
SUBMIT_ORDERS=0
RUNTIME_DB_FILE=/Users/your-user/momentum_alpha/var/runtime.db
SERVERCHAN_SENDKEY=
# Optional space-separated USDⓈ-M perpetual symbol whitelist.
# Leave empty to auto-discover all Binance USDⓈ-M perpetual contracts.
SYMBOLS=
# Base veto: A/B/C/D/E OR breakout+pullback, computed from completed 1m candles only.
BASE_VETO_ENABLED=1
BASE_VETO_ATR_15M_PCT_THRESHOLD=3
BASE_VETO_TRADE_COUNT_RATIO_30M_THRESHOLD=1
BASE_VETO_RETURN_TO_VOL_15M_THRESHOLD=0.5
BASE_VETO_TRADE_COUNT_RATIO_30M_C_THRESHOLD=0.75
BASE_VETO_TAKER_BUY_SHARE_15M_THRESHOLD=0.50
BASE_VETO_EFFICIENCY_15M_D_THRESHOLD=0.15
BASE_VETO_EFFICIENCY_15M_E_THRESHOLD=0.45
BASE_VETO_RANGE_EXPANSION_15M_THRESHOLD=1.50
BASE_VETO_BREAKOUT_5M_PCT_THRESHOLD=0.50
BASE_VETO_PULLBACK_5M_PCT_THRESHOLD=1.25
