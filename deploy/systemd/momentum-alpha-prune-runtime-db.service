[Unit]
Description=Momentum Alpha Runtime Database Pruning
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/momentum_alpha
EnvironmentFile=%h/momentum_alpha/deploy/env.local
ExecStart=%h/momentum_alpha/scripts/run_prune_runtime_db.sh
StandardOutput=append:%h/momentum_alpha/var/log/momentum-alpha-prune-runtime-db.log
StandardError=append:%h/momentum_alpha/var/log/momentum-alpha-prune-runtime-db.log

[Install]
WantedBy=multi-user.target
